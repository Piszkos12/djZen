object MainForm: TMainForm
  Left = 400
  Height = 720
  Top = 80
  Width = 520
  Caption = 'djZen'
  Constraints.MinHeight = 480
  Constraints.MinWidth = 420
  Position = poScreenCenter
  ShowHint = True
  OnCreate = FormCreate
  OnClose = FormClose
  OnCloseQuery = FormCloseQuery
  OnDestroy = FormDestroy
  OnShow = FormShow
  object TopPanel: TPanel
    Left = 0
    Height = 232
    Top = 0
    Width = 520
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 232
    ClientWidth = 520
    TabOrder = 0
    object ZenButton: TButton
      AnchorSideLeft.Control = TopPanel
      AnchorSideTop.Control = TopPanel
      AnchorSideRight.Control = TopPanel
      AnchorSideRight.Side = asrBottom
      Left = 16
      Height = 90
      Top = 16
      Width = 488
      Anchors = [akTop, akLeft, akRight]
      BorderSpacing.Left = 16
      BorderSpacing.Top = 16
      BorderSpacing.Right = 16
      Caption = 'ZEN'
      Font.Height = -36
      Font.Style = [fsBold]
      OnClick = ZenButtonClick
      ParentFont = False
      TabOrder = 0
    end
    object ProfileLabel: TLabel
      AnchorSideLeft.Control = TopPanel
      AnchorSideTop.Control = ProfileCombo
      AnchorSideTop.Side = asrCenter
      Left = 16
      Height = 20
      Top = 120
      Width = 90
      AutoSize = False
      BorderSpacing.Left = 16
      Caption = 'Profile:'
    end
    object ProfileMenuButton: TButton
      AnchorSideTop.Control = ProfileCombo
      AnchorSideTop.Side = asrCenter
      AnchorSideRight.Control = TopPanel
      AnchorSideRight.Side = asrBottom
      Left = 474
      Height = 28
      Hint = 'Save, delete, import or export profiles'
      Top = 116
      Width = 30
      Anchors = [akTop, akRight]
      BorderSpacing.Right = 16
      Caption = '...'
      OnClick = ProfileMenuButtonClick
      TabOrder = 2
    end
    object ProfileCombo: TComboBox
      AnchorSideLeft.Control = ProfileLabel
      AnchorSideLeft.Side = asrBottom
      AnchorSideTop.Control = ZenButton
      AnchorSideTop.Side = asrBottom
      AnchorSideRight.Control = ProfileMenuButton
      Left = 106
      Height = 28
      Top = 116
      Width = 362
      Anchors = [akTop, akLeft, akRight]
      BorderSpacing.Top = 10
      BorderSpacing.Right = 6
      ItemHeight = 20
      OnChange = ProfileComboChange
      Style = csDropDownList
      TabOrder = 1
    end
    object AppLabel: TLabel
      AnchorSideLeft.Control = TopPanel
      AnchorSideTop.Control = AppCombo
      AnchorSideTop.Side = asrCenter
      Left = 16
      Height = 20
      Top = 156
      Width = 90
      AutoSize = False
      BorderSpacing.Left = 16
      Caption = 'DJ software:'
    end
    object AppCombo: TComboBox
      AnchorSideLeft.Control = AppLabel
      AnchorSideLeft.Side = asrBottom
      AnchorSideTop.Control = ProfileCombo
      AnchorSideTop.Side = asrBottom
      AnchorSideRight.Control = TopPanel
      AnchorSideRight.Side = asrBottom
      Left = 106
      Height = 28
      Hint = 'The selected DJ software is protected and gets a higher priority'
      Top = 152
      Width = 398
      Anchors = [akTop, akLeft, akRight]
      BorderSpacing.Top = 8
      BorderSpacing.Right = 16
      ItemHeight = 20
      OnChange = AppComboChange
      Style = csDropDownList
      TabOrder = 3
    end
    object RecheckButton: TButton
      AnchorSideTop.Control = AppCombo
      AnchorSideTop.Side = asrBottom
      AnchorSideRight.Control = TopPanel
      AnchorSideRight.Side = asrBottom
      Left = 404
      Height = 30
      Top = 190
      Width = 100
      Anchors = [akTop, akRight]
      BorderSpacing.Top = 10
      BorderSpacing.Right = 16
      Caption = 'Check again'
      OnClick = RecheckButtonClick
      TabOrder = 4
    end
    object StatusLabel: TLabel
      AnchorSideLeft.Control = TopPanel
      AnchorSideTop.Control = RecheckButton
      AnchorSideTop.Side = asrCenter
      AnchorSideRight.Control = RecheckButton
      Left = 16
      Height = 20
      Top = 195
      Width = 378
      Anchors = [akTop, akLeft, akRight]
      AutoSize = False
      BorderSpacing.Left = 16
      BorderSpacing.Right = 10
      Caption = 'Ready'
    end
  end
  object DisclaimerLabel: TLabel
    Left = 16
    Height = 34
    Top = 678
    Width = 488
    Align = alBottom
    BorderSpacing.Left = 16
    BorderSpacing.Right = 16
    BorderSpacing.Bottom = 8
    Caption = 'Use at your own risk. djZen is provided "as is", without warranty or liability. See README and LICENSE.'
    Font.Color = clGrayText
    ParentFont = False
    WordWrap = True
  end
  object OptionsBox: TScrollBox
    Left = 0
    Height = 446
    Top = 232
    Width = 520
    HorzScrollBar.Visible = False
    VertScrollBar.Increment = 20
    VertScrollBar.Tracking = True
    Align = alClient
    BorderStyle = bsNone
    ChildSizing.LeftRightSpacing = 16
    ChildSizing.TopBottomSpacing = 8
    ChildSizing.VerticalSpacing = 12
    ChildSizing.EnlargeHorizontal = crsHomogenousChildResize
    ChildSizing.Layout = cclLeftToRightThenTopToBottom
    ChildSizing.ControlsPerLine = 1
    TabOrder = 1
  end
  object ProfileMenu: TPopupMenu
    OnPopup = ProfileMenuPopup
    Left = 440
    Top = 300
    object MenuSave: TMenuItem
      Caption = 'Save changes'
      OnClick = MenuSaveClick
    end
    object MenuSaveAs: TMenuItem
      Caption = 'Save as new profile...'
      OnClick = MenuSaveAsClick
    end
    object MenuDelete: TMenuItem
      Caption = 'Delete profile'
      OnClick = MenuDeleteClick
    end
    object MenuSep: TMenuItem
      Caption = '-'
    end
    object MenuImport: TMenuItem
      Caption = 'Import profile...'
      OnClick = MenuImportClick
    end
    object MenuExport: TMenuItem
      Caption = 'Export profile...'
      OnClick = MenuExportClick
    end
  end
end
