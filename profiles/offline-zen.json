{
  "name": "Offline zen",
  "order": 1,
  "description": "Maximum lockdown for a live set without network: everything that can disturb the audio is switched off.",
  "tweaks": {
    "notify.toasts": true,
    "notify.system-sounds": true,
    "notify.audio-ducking": true,
    "power.usb-selective-suspend": true,
    "power.sleep": true,
    "power.pcie-aspm": true,
    "power.cpu-min-state": true,
    "power.display-off": true,
    "power.hibernate": true,
    "radio.wifi": true,
    "radio.bluetooth": true,
    "service.windows-update": true,
    "service.windows-search": true,
    "service.sysmain": true
  }
}
